PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/dhanwantari

# Auth.js - generate with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Only needed in production (public URL of the app)
# AUTH_URL=https://your-domain.com/auth

CLIENT_URL=http://localhost:5173

# FastAPI ML service (see ml_service_patch/). Set ML_MOCK=true to run the app without it.
ML_API_URL=http://127.0.0.1:8000
ML_MOCK=false

# Optional: e-mail the published report to the patient. Leave empty to skip.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# E-mails never include medical details. Set true to also attach the handwritten report file.
MAIL_ATTACH_REPORT=false
MAIL_FROM="Dhanwantari <no-reply@yourdomain.com>"
